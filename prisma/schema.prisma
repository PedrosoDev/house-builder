generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String   @id
  name      String
  /// Serialized planner project document (see src/lib/planner/types.ts)
  data      String
  /// Optional PNG data URL used as the card preview
  thumbnail String?
  floors    Int      @default(1)
  area      Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
